# MongoDB 연결 문자열. 로컬에 MongoDB 가 없으면 `npm run db` 로 개발용 DB 를 띄울 수 있다.
MONGODB_URI=mongodb://127.0.0.1:27017/planner

# GitHub OAuth App (README 의 "GitHub 로그인 설정" 참고). 시크릿은 커밋하지 말 것
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 앱의 공개 주소. GitHub OAuth App 의 Authorization callback URL 이
# ${APP_URL}/auth/github/callback 과 정확히 같아야 한다. 비우면 요청 주소를 쓴다
APP_URL=http://localhost:3000
